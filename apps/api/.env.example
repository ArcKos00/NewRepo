# Скопіюйте в apps/api/.env — значення нижче працюють з docker-compose.dev.yml (npm run db:up).
# Змінні, задані в оточенні (run configuration, shell), мають перевагу над цим файлом.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5442/orders
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=50

# Вхід через Keycloak (як у litopys). Клієнт confidential: Standard flow + Direct Access Grants,
# redirect URI = PUBLIC_URL/auth/callback. Dev-realm: користувачі dev/dev, operator/operator.
KEYCLOAK_ISSUER=http://localhost:8081/realms/purchase
KEYCLOAK_CLIENT_ID=purchase
KEYCLOAK_CLIENT_SECRET=purchase-dev-secret
# Keycloak кластера (https://auth.infrastructure.kub.k2.lan/realms/...) підписаний внутрішнім CA K2:
# 1 — довіряти сертифікатам ОС (CA має бути встановлено в систему, як для curl).
#NODE_USE_SYSTEM_CA=1
# Адреса, яку бачить браузер. З Vite — http://localhost:5173 (проксі /api і /auth → :3000).
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=dev-session-secret
SESSION_MAX_HOURS=12
# Роль користувача в realm Keycloak (realm_access.roles), що відкриває журнал дій.
#ADMIN_ROLE=admin
# true — без Keycloak, усе від dev-користувача. При NODE_ENV=production заборонено.
#AUTH_DISABLED=true
# Перегляд, пошук і фільтри без входу (зміни — лише після входу). false — усе лише після входу.
#ANONYMOUS_READ=false
# Разом з AUTH_DISABLED: false — dev-користувач без прав адміна (перевірити, як бачать журнал інші).
#DEV_USER_ADMIN=false

# Логи (pino): debug — ще й тексти всіх SQL-запитів; LOG_PRETTY — людиночитні замість JSON.
LOG_LEVEL=info
LOG_PRETTY=true
SLOW_QUERY_MS=1000

# Тести API (npm test) — окрема база, яку тести повністю очищують.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5442/orders_test

# OpenTelemetry → Elastic APM (OTLP/HTTP). Порожній endpoint = вимкнено.
# Або стандартні OTEL_* (вони мають перевагу), або ELASTIC_APM_* (токен стане заголовком Authorization).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://apm-server.infrastructure.svc.cluster.local:8200
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <secret token>
#ELASTIC_APM_SERVER_URL=https://apm.example:8200
#ELASTIC_APM_SECRET_TOKEN=
#ELASTIC_APM_ENVIRONMENT=development
#OTEL_SERVICE_NAME=purchase
#OTEL_RESOURCE_ATTRIBUTES=group=gov
# Заголовки HTTP в атрибутах спанів (cookie/authorization маскуються); тіла записів — у трейсах.
#OTEL_CAPTURE_HEADERS=true
#OTEL_CAPTURE_BODY=true
