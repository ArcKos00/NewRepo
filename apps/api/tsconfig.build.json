{
  "extends": "./tsconfig.json",
  // tsbuildinfo — всередині dist: nest (deleteOutDir) стирає їх разом, інакше tsc вважає, що все зібрано, і нічого не пише.
  "compilerOptions": { "rootDir": "./src", "types": ["node", "multer"], "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo" },
  "include": ["src"]
}
