PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=50

# Вхід через Keycloak (як у litopys). Клієнт confidential: Standard flow + Direct Access Grants,
# redirect URI = PUBLIC_URL/auth/callback.
KEYCLOAK_ISSUER=http://localhost:8080/realms/k2
KEYCLOAK_CLIENT_ID=purchase
KEYCLOAK_CLIENT_SECRET=
# Адреса, яку бачить браузер. У розробці з Vite — http://localhost:5173 (проксі /api і /auth → :3000).
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=change-me
SESSION_MAX_HOURS=12
# true — без Keycloak, усе від dev-користувача. При NODE_ENV=production заборонено.
#AUTH_DISABLED=true

# OpenTelemetry → Elastic APM. Порожньо = вимкнено. OTEL_* (OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME…) теж працюють.
#ELASTIC_APM_SERVER_URL=https://apm.example:8200
#ELASTIC_APM_SECRET_TOKEN=
#ELASTIC_APM_ENVIRONMENT=development
#ELASTIC_APM_GLOBAL_LABELS=project=purchase
#OTEL_CAPTURE_BODY=true
