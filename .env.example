PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=50

# --- Вхід (один користувач) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Ключ підпису cookie сесії (openssl rand -hex 32). Без нього сесії скидаються при перезапуску.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Secure-cookie; за замовчуванням true при NODE_ENV=production
COOKIE_SECURE=false
MAX_FAILED_LOGINS=10

# --- Логи ---
LOG_LEVEL=info          # debug — ще й тексти всіх SQL-запитів
LOG_PRETTY=true         # людиночитні логи замість JSON (лише локально)
SLOW_QUERY_MS=1000

# --- OpenTelemetry → Elastic (порожній endpoint = вимкнено) ---
OTEL_SERVICE_NAME=purchase
OTEL_EXPORTER_OTLP_ENDPOINT=
# Elastic APM: Authorization=Bearer <secret token> або Authorization=ApiKey <base64 key>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Усі заголовки HTTP — в атрибути спанів (cookie/authorization маскуються)
OTEL_CAPTURE_HEADERS=true
APP_ENV=development
